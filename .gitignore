# Virtual environment
venv/
.venv/
env/

# Secrets — env files
.env
.env.*
.env.local
.env.production
!.env.example
!frontend/.env.example

# Secrets — YouTube / Netscape cookie credentials (never commit real cookies)
# Matches cookies.txt, extension_cookies.txt, *cookies*.txt, yt_cookies_*.txt, etc.
*cookies*.txt
!*cookies.example.txt
!**/*cookies.example.txt
yt_cookies_*.txt
**/yt_cookies_*.txt

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
dist/
build/

# Cache / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Pipeline artifacts (regenerable / large)
downloads/
transcripts/
output_clips/

# Temporary media created during processing
temp_audio.mp3
temp.srt
temp_*.mp3
temp_*.srt
*.tmp

# Next.js frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env*.local

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*~

# Logs
*.log
