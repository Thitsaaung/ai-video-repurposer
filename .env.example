# ==========================================
# AI Providers
# ==========================================

OPENAI_API_KEY=...

# Optional
ANTHROPIC_API_KEY=...

# ==========================================
# FastAPI
# ==========================================
APP_ENV=development

APP_NAME=AI Video Repurposer API

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated list
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# YouTube / yt-dlp cookies (Phase 1)
# ==========================================
# Prefer a dedicated Google account. Never commit real cookies.
#
# Option A — path to a Netscape cookies.txt file:
# YOUTUBE_COOKIES_FILE=/path/to/cookies.txt
#
# Option B — base64 of that file (recommended on Railway):
# YOUTUBE_COOKIES_BASE64=...
#
# Resolution order: existing file path → base64 temp file → no cookies.

# ==========================================
# Clip render padding (cutter only; curated JSON unchanged)
# ==========================================
# CLIP_PAD_START_SECONDS=3
# CLIP_PAD_END_SECONDS=1

# ==========================================
# Railway (Railpack) — set as Service Variables
# ==========================================
# Runtime apt packages for the final image (space-separated).
# Required for yt-dlp format merge + FFmpeg clip cutting.
# RAILPACK_DEPLOY_APT_PACKAGES=ffmpeg
#
# Optional: JS runtime for yt-dlp YouTube EJS (Mise package).
# RAILPACK_PACKAGES=node
#
# YouTube cookies (use ONE of these on Railway):
# YOUTUBE_COOKIES_FILE=/path/to/cookies.txt
# YOUTUBE_COOKIES_BASE64=...
#
# Optional: enable temporary yt-dlp startup probes (contacts YouTube via -F).
# Leave unset/false in production. Set only when debugging:
# DIAG_YTDLP=true

# ==========================================
# Next.js (frontend/.env.local)
# ==========================================
# Full Vercel + Railway steps: frontend/DEPLOY.md
# Template: frontend/.env.example
#
# Development
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
#
# Production (Vercel project env — required; HTTPS Railway URL, no trailing slash)
# NEXT_PUBLIC_API_BASE=https://your-backend.up.railway.app
#
# NEXT_PUBLIC_POLL_INTERVAL_MS=5000
#
# Railway CORS must include the Vercel origin, e.g.:
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000,http://127.0.0.1:3000
