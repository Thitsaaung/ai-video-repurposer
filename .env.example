# ==========================================
# AI Providers
# ==========================================

OPENAI_API_KEY=...

# Optional
ANTHROPIC_API_KEY=...

# ==========================================
# FastAPI
# ==========================================
APP_ENV=development

APP_NAME=AI Video Repurposer API

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated list
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# Supabase Auth (Phase 0 — config foundation)
# ==========================================
# DEC-020: Supabase Auth is the authentication provider.
# Phase 0 loads/validates these vars only — no JWT middleware yet.
# See docs/auth_implementation_plan.md (Phase 0).
#
# Required in production (APP_ENV=production|staging|preview):
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_JWT_SECRET  (or SUPABASE_JWKS_URL)
#
# Optional (server-only — never expose to the browser / never commit):
#   SUPABASE_SERVICE_ROLE_KEY
#
# Local development: omit all Supabase vars to start the API without auth
# config (warning logged). If any Supabase var is set, the full required
# set must be present.
#
# Optional local bypass (NEVER set in production):
# AUTH_DISABLED=true
#
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_JWT_SECRET=your-jwt-secret-from-project-settings
# SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ==========================================
# YouTube / yt-dlp cookies (Phase 1)
# ==========================================
# Prefer a dedicated Google account. Never commit real cookies.
# Real cookie files are gitignored (*cookies*.txt); only cookies.example.txt is tracked.
# Template: backend/cookies.example.txt → copy to backend/cookies.txt
# Full workflow: docs/cookies_secret_management.md
#
# Option A — local Netscape file (gitignored):
# YOUTUBE_COOKIES_FILE=cookies.txt
#
# Option B — base64 of that file (recommended on Railway):
# YOUTUBE_COOKIES_BASE64=...
#
# Resolution order: existing file path → base64 temp file → no cookies.
# Use ONE of these; never commit the file or the base64 blob.

# ==========================================
# Clip render padding (cutter only; curated JSON unchanged)
# ==========================================
# CLIP_PAD_START_SECONDS=3
# CLIP_PAD_END_SECONDS=1

# ==========================================
# Storage cleanup / retention
# ==========================================
# Automatic cleanup of downloads, transcripts, output clips, temps, and
# expired in-memory jobs. Never deletes active (queued/processing) jobs.
# STORAGE_CLEANUP_ENABLED=true
# STORAGE_CLEANUP_INTERVAL_MINUTES=30
# STORAGE_DOWNLOADS_RETENTION_HOURS=24
# STORAGE_TRANSCRIPTS_RETENTION_HOURS=24
# STORAGE_CLIPS_RETENTION_HOURS=48
# STORAGE_TEMP_RETENTION_HOURS=1
# STORAGE_FAILED_JOB_RETENTION_HOURS=12
# STORAGE_COMPLETED_JOB_RETENTION_HOURS=48

# ==========================================
# Railway (Railpack) — set as Service Variables
# ==========================================
# Runtime apt packages for the final image (space-separated).
# Required for yt-dlp format merge + FFmpeg clip cutting.
# RAILPACK_DEPLOY_APT_PACKAGES=ffmpeg
#
# Optional: JS runtime for yt-dlp YouTube EJS (Mise package).
# RAILPACK_PACKAGES=node
#
# YouTube cookies on Railway — prefer BASE64 (no cookie file in the image):
# YOUTUBE_COOKIES_BASE64=...
#
# Production auth foundation (required when APP_ENV=production):
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=...
# SUPABASE_JWT_SECRET=...
# SUPABASE_SERVICE_ROLE_KEY=...   # server-only; never commit

# ==========================================
# Next.js (frontend/.env.local)
# ==========================================
# Full Vercel + Railway steps: frontend/DEPLOY.md
# Template: frontend/.env.example
#
# Development
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
#
# Production (Vercel project env — required; HTTPS Railway URL, no trailing slash)
# NEXT_PUBLIC_API_BASE=https://your-backend.up.railway.app
#
# NEXT_PUBLIC_POLL_INTERVAL_MS=5000
#
# Railway CORS must include the Vercel origin, e.g.:
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000,http://127.0.0.1:3000
