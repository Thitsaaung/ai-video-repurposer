# T-Clipper frontend (Next.js) — local only
# Copy to .env.local and adjust. Do not commit .env.local.

# FastAPI origin (no trailing slash)
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Optional poll interval (ms). Default: 5000
# NEXT_PUBLIC_POLL_INTERVAL_MS=5000

# --- Supabase (Phase 0 — document only; login UI is Phase 1) ---
# Public anon key is safe for the browser; never put the service role here.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Vercel production ---
# Set these in the Vercel project Environment Variables UI (Production):
#   NEXT_PUBLIC_API_BASE=https://your-backend.up.railway.app
#   NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# Root Directory must be: frontend
# See DEPLOY.md for full steps.
# Backend (Railway) must also set SUPABASE_* + APP_ENV=production.
